{
	"name": "n8n-nodes-lunch-money",
	"version": "0.1.0",
	"description": "n8n community node for the Lunch Money personal finance API (v2)",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"lunch-money",
		"finance",
		"budgeting",
		"transactions"
	],
	"license": "MIT",
	"author": {
		"name": "TensE"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ITensEI/n8n-nodes-lunchmoney.git"
	},
	"homepage": "https://github.com/ITensEI/n8n-nodes-lunchmoney#readme",
	"bugs": {
		"url": "https://github.com/ITensEI/n8n-nodes-lunchmoney/issues"
	},
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"generate": "node scripts/generate-node.js",
		"lint": "eslint nodes credentials --ext .ts",
		"test": "node --test test/spec-sync-fields.test.js",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/LunchMoneyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/LunchMoney/LunchMoney.node.js"
		]
	},
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
		"eslint": "^8.57.1",
		"gulp": "^5.0.1",
		"js-yaml": "^5.2.3",
		"n8n-workflow": "^2.16.0",
		"prettier": "^3.2.0",
		"typescript": "^5.3.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
